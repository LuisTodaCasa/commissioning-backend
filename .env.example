# Banco de dados (Neon PostgreSQL)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# JWT - gere com: openssl rand -hex 32
JWT_SECRET_KEY=<gerar-com-openssl-rand-hex-32>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS - domínios permitidos (JSON array)
CORS_ORIGINS=["https://seu-dominio.abacusai.app","http://localhost:3000"]

# Ambiente
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=INFO

# Upload
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=50

# SMTP (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@consorciouhn.com.br
SMTP_TLS=true

# Cloudflare R2 (opcional)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
