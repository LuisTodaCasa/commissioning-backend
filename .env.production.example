# ==========================================================================
# Configuração de PRODUÇÃO - Sistema de Comissionamento
# --------------------------------------------------------------------------
# Copie este arquivo para `.env` no ambiente de produção e substitua os
# valores de exemplo pelos valores reais. NUNCA versione o arquivo `.env`.
# ==========================================================================

# Banco de dados (Neon PostgreSQL)
# Use a connection string fornecida pelo painel do Neon.
# É obrigatório o parâmetro ?sslmode=require em produção.
DATABASE_URL=postgresql://usuario_prod:senha_forte@ep-xxxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# JWT
# Gere uma chave forte e única: openssl rand -hex 32 (ou ./scripts/generate_secret.sh)
# NÃO reutilize a chave de desenvolvimento em produção.
JWT_SECRET_KEY=troque-por-uma-chave-de-64-caracteres-gerada-com-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS - somente os domínios reais do frontend em produção (JSON array)
CORS_ORIGINS=["https://app.consorciouhn.com.br","https://seu-dominio.abacusai.app"]

# Ambiente - deve ser "production" para desativar o auto-create de tabelas
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=INFO

# Upload - diretório persistente montado no servidor de produção
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=50

# SMTP - servidor de e-mail real usado para notificações e reset de senha
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notificacoes@consorciouhn.com.br
SMTP_PASSWORD=senha-de-app-do-smtp
SMTP_FROM=noreply@consorciouhn.com.br
SMTP_TLS=true

# Cloudflare R2 (opcional) - armazenamento de objetos para uploads
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
